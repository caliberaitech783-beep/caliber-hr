generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum RecordStatus { DRAFT PENDING_REVIEW APPROVED REJECTED ACTIVE INACTIVE }
enum EmployeeStatus { DRAFT PENDING ACTIVE INACTIVE SEPARATED }
enum ApprovalState { PENDING APPROVED REJECTED RETURNED CANCELLED }

model Company { id String @id @default(uuid()) @db.Uuid code String @unique name String registeredAddress String? corporateAddress String? contactNumber String? email String? status RecordStatus @default(DRAFT) sites Site[] departments Department[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Client { id String @id @default(uuid()) @db.Uuid code String @unique name String contactDetails Json? status RecordStatus @default(DRAFT) sites Site[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Region { id String @id @default(uuid()) @db.Uuid code String @unique name String state String status RecordStatus @default(DRAFT) sites Site[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Site { id String @id @default(uuid()) @db.Uuid code String @unique name String companyId String @db.Uuid clientId String? @db.Uuid regionId String @db.Uuid state String district String? address String? siteType String projectManagerId String? @db.Uuid siteHrId String? @db.Uuid effectiveFrom DateTime status RecordStatus @default(DRAFT) company Company @relation(fields:[companyId],references:[id]) client Client? @relation(fields:[clientId],references:[id]) region Region @relation(fields:[regionId],references:[id]) employees Employee[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([companyId,regionId,status]) }
model Department { id String @id @default(uuid()) @db.Uuid code String name String description String? companyId String @db.Uuid status RecordStatus @default(DRAFT) company Company @relation(fields:[companyId],references:[id]) employees Employee[] mappings DepartmentDesignation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([companyId,code]) @@unique([companyId,name]) }
model Grade { id String @id @default(uuid()) @db.Uuid code String @unique name String rank Int description String? status RecordStatus @default(DRAFT) designations Designation[] employees Employee[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Designation { id String @id @default(uuid()) @db.Uuid code String @unique name String gradeId String @db.Uuid reportingLevel Int? status RecordStatus @default(DRAFT) grade Grade @relation(fields:[gradeId],references:[id]) mappings DepartmentDesignation[] employees Employee[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model DepartmentDesignation { departmentId String @db.Uuid designationId String @db.Uuid department Department @relation(fields:[departmentId],references:[id]) designation Designation @relation(fields:[designationId],references:[id]) @@id([departmentId,designationId]) }
model Employee { id String @id @default(uuid()) @db.Uuid employeeNumber String @unique fullName String email String? mobile String? dateOfBirth DateTime? joiningDate DateTime? category String? companyId String @db.Uuid siteId String? @db.Uuid departmentId String? @db.Uuid designationId String? @db.Uuid gradeId String? @db.Uuid managerId String? @db.Uuid status EmployeeStatus @default(DRAFT) company Company @relation(fields:[companyId],references:[id]) site Site? @relation(fields:[siteId],references:[id]) department Department? @relation(fields:[departmentId],references:[id]) designation Designation? @relation(fields:[designationId],references:[id]) grade Grade? @relation(fields:[gradeId],references:[id]) manager Employee? @relation("Reporting",fields:[managerId],references:[id]) reports Employee[] @relation("Reporting") documents EmployeeDocument[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([siteId,status]) @@index([departmentId,status]) }
model EmployeeDocument { id String @id @default(uuid()) @db.Uuid employeeId String @db.Uuid documentType String storageKey String mimeType String sizeBytes Int uploadedById String @db.Uuid employee Employee @relation(fields:[employeeId],references:[id]) createdAt DateTime @default(now()) @@index([employeeId,documentType]) }
model Role { id String @id @default(uuid()) @db.Uuid code String @unique name String userRoles UserRole[] permissions RolePermission[] }
model Permission { id String @id @default(uuid()) @db.Uuid module String action String roles RolePermission[] @@unique([module,action]) }
model User { id String @id @default(uuid()) @db.Uuid email String @unique passwordHash String displayName String status RecordStatus @default(ACTIVE) roles UserRole[] sessions Session[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model UserRole { userId String @db.Uuid roleId String @db.Uuid companyId String? @db.Uuid regionId String? @db.Uuid siteId String? @db.Uuid user User @relation(fields:[userId],references:[id]) role Role @relation(fields:[roleId],references:[id]) @@id([userId,roleId]) }
model RolePermission { roleId String @db.Uuid permissionId String @db.Uuid role Role @relation(fields:[roleId],references:[id]) permission Permission @relation(fields:[permissionId],references:[id]) @@id([roleId,permissionId]) }
model Session { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid tokenHash String @unique expiresAt DateTime revokedAt DateTime? user User @relation(fields:[userId],references:[id]) createdAt DateTime @default(now()) @@index([userId,expiresAt]) }
model ApprovalWorkflow { id String @id @default(uuid()) @db.Uuid code String name String module String status RecordStatus @default(DRAFT) versions ApprovalWorkflowVersion[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([module,code]) }
model ApprovalWorkflowVersion { id String @id @default(uuid()) @db.Uuid workflowId String @db.Uuid version Int definition Json effectiveFrom DateTime effectiveTo DateTime? workflow ApprovalWorkflow @relation(fields:[workflowId],references:[id]) requests ApprovalRequest[] createdAt DateTime @default(now()) @@unique([workflowId,version]) }
model ApprovalRequest { id String @id @default(uuid()) @db.Uuid workflowVersionId String @db.Uuid entityType String entityId String @db.Uuid requestedById String @db.Uuid state ApprovalState @default(PENDING) currentStage Int @default(1) workflowVersion ApprovalWorkflowVersion @relation(fields:[workflowVersionId],references:[id]) decisions ApprovalDecision[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([entityType,entityId]) }
model ApprovalDecision { id String @id @default(uuid()) @db.Uuid requestId String @db.Uuid stage Int decidedById String @db.Uuid decision ApprovalState comments String? request ApprovalRequest @relation(fields:[requestId],references:[id]) decidedAt DateTime @default(now()) @@index([requestId,stage]) }
model AuditLog { id BigInt @id @default(autoincrement()) actorId String? @db.Uuid action String entityType String entityId String? @db.Uuid before Json? after Json? ipAddress String? correlationId String @db.Uuid createdAt DateTime @default(now()) @@index([entityType,entityId]) @@index([actorId,createdAt]) }
